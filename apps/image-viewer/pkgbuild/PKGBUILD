pkgname=omarchy-image-viewer
pkgver=0.1.0
pkgrel=3
pkgdesc='A minimal photo viewer for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-imageformats' 'qt6-svg'
         'kimageformats' 'libheif' 'libavif' 'libjxl' 'openjpeg2' 'openexr'
         'libjpeg-turbo' 'exiv2' 'xdg-desktop-portal')
optdepends=('localsend: send photos to nearby devices')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  "$startdir/../bin/build"
}

check() {
  "$startdir/../bin/test"
}

package() {
  install -Dm755 "$startdir/../build/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$startdir/../../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 "$startdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
}
