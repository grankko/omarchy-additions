pkgname=omarchy-image-viewer
pkgver=0.3.1
pkgrel=1
pkgdesc='A minimal photo viewer for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base>=6.12' 'qt6-declarative' 'qt6-wayland' 'qt6-imageformats' 'qt6-svg'
         'kimageformats' 'libheif' 'libavif' 'libjxl' 'openjpeg2' 'openexr'
         'libjpeg-turbo' 'exiv2' 'xdg-desktop-portal')
optdepends=('localsend: send photos to nearby devices')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('a245d327517008263ab8e335ca39ad66ea9a6c34e97b13c9480e7b38384c5e6f')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  test "$(cat VERSION)" = "$pkgver"
  VIEWER_BUILD_DIR="$srcdir/viewer-build" ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  VIEWER_BUILD_DIR="$srcdir/viewer-tests" ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/viewer-build/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "pkgbuild/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 "pkgbuild/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
}
